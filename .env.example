# New Relic Configuration
# Get your license key from: https://one.newrelic.com/launcher/api-keys-ui.api-keys-launcher
NEW_RELIC_LICENSE_KEY=your_license_key_here
NEW_RELIC_APP_NAME=Fullstack Checkout Service

# Optional: Set log level (critical, error, warning, info, debug)
NEW_RELIC_LOG_LEVEL=info

# Optional: Enable/disable New Relic monitoring
NEW_RELIC_ENABLED=true
